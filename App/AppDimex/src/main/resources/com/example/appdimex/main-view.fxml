<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      spacing="15.0"
      prefHeight="650.0"
      prefWidth="340.0"
      fillWidth="true"

      styleClass="ventana-principal"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.appdimex.Controllers.MainController">

    <HBox alignment="CENTER_LEFT"
          spacing="10.0">

        <Pane prefHeight="50.0"
              prefWidth="50.0"
              styleClass="logo-container">

            <ImageView fx:id="logoImageView"
                       fitHeight="50.0"
                       fitWidth="50.0"
                       preserveRatio="true"/>
        </Pane>

        <Region HBox.hgrow="ALWAYS"/>

        <MenuButton mnemonicParsing="false"
                    text="Menú"
                    prefWidth="95.0">

            <items>
                <MenuItem fx:id="registrarProspectoMenuItem"
                          mnemonicParsing="false"
                          text="Registrar Prospecto"/>

                <MenuItem fx:id="ayudaMenuItem"
                          mnemonicParsing="false"
                          text="Ayuda"/>
            </items>

        </MenuButton>

    </HBox>

    <VBox alignment="CENTER"
          spacing="8.0"
          prefHeight="130.0">

        <Label text="Bienvenido a tu aplicación DIMEX"
               styleClass="welcome-label"
               textAlignment="CENTER"
               alignment="CENTER"
               wrapText="true"
               maxWidth="300.0"/>

        <Label text="Selecciona una opción para continuar"
               styleClass="label"
               textAlignment="CENTER"
               wrapText="true"/>

    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER"
          spacing="14.0"
          fillHeight="true">

        <Button fx:id="reProspecto"
                text="Registrar&#10;Prospecto"
                mnemonicParsing="false"
                onAction="#abrirRegistroProspecto"
                styleClass="btn-action"
                prefHeight="90.0"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
                textAlignment="CENTER"
                wrapText="true"/>

        <Button fx:id="consProspectos"
                text="Consultar&#10;Prospectos"
                mnemonicParsing="false"
                onAction="#abrirConsultaProspectos"
                styleClass="btn-action"
                prefHeight="90.0"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
                textAlignment="CENTER"
                wrapText="true"/>

    </HBox>

    <Button fx:id="cotizarButton"
            text="Cotización Express"
            mnemonicParsing="false"
            onAction="#abrirCotizacion"
            styleClass="btn-highlight"
            prefHeight="65.0"
            maxWidth="Infinity"
            textAlignment="CENTER"
            wrapText="true"/>

    <Button fx:id="cambiarTasasButton"
            text="Cambiar Tasas"
            mnemonicParsing="false"
            onAction="#abrirCambiarTasas"
            styleClass="btn-action"
            prefHeight="50.0"
            maxWidth="Infinity"
            visible="false"
            managed="false"/>

    <Region minHeight="5.0"/>

</VBox>
