<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="320.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.appdimex.Controllers.LoginController">
   <children>
      <!-- Logo -->
      <ImageView fx:id="logoImageView" fitHeight="50" fitWidth="50" layoutX="10.0" layoutY="10.0" preserveRatio="true" />

      <!-- Título -->
      <Label alignment="CENTER" layoutX="99.0" layoutY="24.0" prefHeight="17.0" prefWidth="162.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Inicio Sesión" />

      <!-- Usuario -->
      <Label alignment="CENTER" layoutX="35.0" layoutY="102.0" prefHeight="34.0" prefWidth="250.0" text="Usuario" />
      <TextField fx:id="usuarioTextField" layoutX="34.0" layoutY="143.0" prefHeight="25.0" prefWidth="252.0" promptText="Ingrese su usuario" />

      <!-- Contraseña -->
      <Label alignment="CENTER" layoutX="35.0" layoutY="193.0" prefHeight="34.0" prefWidth="250.0" text="Contraseña" />
      <PasswordField fx:id="contrasenaField" layoutX="34.0" layoutY="234.0" prefHeight="25.0" prefWidth="252.0" promptText="Ingrese su Contraseña" />

      <!-- Botón Ingresar -->
      <Button fx:id="ingresarButton" layoutX="116.0" layoutY="511.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="90.0" text="Ingresar" />

      <!-- Label para mensajes de error -->
      <Label fx:id="mensajeLabel" layoutX="34.0" layoutY="290.0" prefHeight="30.0" prefWidth="252.0" style="-fx-text-fill: red; -fx-font-size: 12px;" text="" wrapText="true" />
   </children>
</AnchorPane>
