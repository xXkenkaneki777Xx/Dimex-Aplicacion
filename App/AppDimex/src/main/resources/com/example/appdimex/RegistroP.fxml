<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="15.0"
      prefHeight="650.0"
      prefWidth="340.0"
      fillWidth="true"
      styleClass="ventana-principal"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.appdimex.Controllers.RegistroController">

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">

        <ImageView fx:id="logoImageView"
                   fitHeight="50.0"
                   fitWidth="50.0"
                   preserveRatio="true"/>

        <Label text="Registro de Prospectos"
               styleClass="titulo-secundario"
               maxWidth="Infinity"
               HBox.hgrow="ALWAYS"/>

        <MenuButton mnemonicParsing="false"
                    text="Menú">
            <items>
                <MenuItem fx:id="registrarProspectoMenuItem"
                          mnemonicParsing="false"
                          text="Registrar Prospecto"/>

                <MenuItem fx:id="ayudaMenuItem"
                          mnemonicParsing="false"
                          text="Ayuda"/>

                <MenuItem fx:id="regresarMenuItem"
                          mnemonicParsing="false"
                          text="Regresar al menú"/>
            </items>
        </MenuButton>

    </HBox>

    <!-- FORMULARIO -->
    <VBox spacing="10.0" fillWidth="true">

        <!-- NOMBRE -->
        <VBox spacing="4.0">
            <Label text="Nombre(s):"/>
            <TextField fx:id="nombreTextField"
                       prefHeight="36.0"
                       promptText="Ingresa el nombre"/>
        </VBox>

        <!-- APELLIDOS -->
        <VBox spacing="4.0">
            <Label text="Apellidos:"/>
            <TextField fx:id="apellidosTextField"
                       prefHeight="36.0"
                       promptText="Ingresa los apellidos"/>
        </VBox>

        <!-- TELÉFONO -->
        <VBox spacing="4.0">
            <Label text="Teléfono:"/>
            <TextField fx:id="telefonoTextField"
                       prefHeight="36.0"
                       promptText="Número telefónico"/>
        </VBox>

        <!-- AFILIACIÓN -->
        <VBox spacing="4.0">
            <Label text="Afiliación:"/>
            <ChoiceBox fx:id="afiliacionChoiceBox"
                       prefHeight="36.0"
                       maxWidth="Infinity"/>
        </VBox>

        <!-- BANCO -->
        <VBox spacing="4.0">
            <Label text="Banco afiliado:"/>
            <TextField fx:id="bancoTextField"
                       prefHeight="36.0"
                       promptText="Nombre del banco"/>
        </VBox>

        <!-- FECHA DE NACIMIENTO -->
        <VBox spacing="4.0">
            <Label text="Fecha de nacimiento:"/>
            <DatePicker fx:id="fechaNacimientoDatePicker"
                        prefHeight="36.0"
                        maxWidth="Infinity"/>
        </VBox>

        <!-- DIRECCIÓN -->
        <VBox spacing="4.0">
            <Label text="Dirección:"/>
            <TextArea fx:id="direccionTextArea"
                      prefHeight="90.0"
                      minHeight="90.0"
                      wrapText="true"
                      promptText="Ingresa la dirección"/>
        </VBox>

    </VBox>

    <!-- ESPACIO FLEXIBLE -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- BOTONES -->
    <HBox alignment="CENTER"
          spacing="20.0">

        <Button fx:id="realizarButton"
                text="Realizar"
                mnemonicParsing="false"
                prefWidth="115.0"
                prefHeight="40.0"
                styleClass="button-exito"/>

        <Button fx:id="cancelarButton"
                text="Cancelar"
                mnemonicParsing="false"
                prefWidth="115.0"
                prefHeight="40.0"
                styleClass="button-peligro"/>

    </HBox>

</VBox>
