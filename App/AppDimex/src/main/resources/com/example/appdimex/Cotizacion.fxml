<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="340.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.appdimex.Controllers.CotizacionController">
    <children>
        <AnchorPane layoutX="5.0" layoutY="5.0" prefHeight="650.0" prefWidth="340.0">
            <children>
                <Pane id="logo" layoutX="14.0" layoutY="14.0" prefHeight="50.0" prefWidth="50.0">
                    <children>
                        <ImageView fx:id="logoImageView" fitHeight="50" fitWidth="50" preserveRatio="true" />
                    </children>
                </Pane>
                <Label alignment="CENTER" layoutX="89.0" layoutY="14.0" prefHeight="17.0" prefWidth="162.0" text="Cotizacion Express" />
                <MenuButton layoutX="269.0" layoutY="19.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="65.0" text="Menu">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Consultar" />
                        <MenuItem mnemonicParsing="false" text="Eliminar" />
                        <MenuItem mnemonicParsing="false" text="Modificar" />
                    </items>
                </MenuButton>
                <Label layoutX="15.0" layoutY="64.0" prefHeight="17.0" prefWidth="85.0" text="Tipo de Cobro:" />
                <ChoiceBox fx:id="tipoCobroChoiceBox" layoutX="132.0" layoutY="60.0" prefWidth="150.0" />
                <Button fx:id="cotizarButton" layoutX="33.0" layoutY="577.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="100.0" text="Cotizar" />
                <Button fx:id="borrarButton" layoutX="196.0" layoutY="577.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="111.0" text="Nueva Cotización" />
                <Label layoutX="15.0" layoutY="104.0" prefHeight="17.0" prefWidth="100.0" text="Tazas de interes:" />
                <ChoiceBox fx:id="tazaInteresChoiceBox" layoutX="132.0" layoutY="100.0" prefWidth="150.0" />
                <Label layoutX="15.0" layoutY="148.0" prefHeight="17.0" prefWidth="85.0" text="Forma de pago:" />
                <ChoiceBox fx:id="formaPagoChoiceBox" layoutX="132.0" layoutY="144.0" prefWidth="150.0" />
                <TableView fx:id="cotizacionTableView" layoutX="70.0" layoutY="325.0" prefHeight="200.0" prefWidth="200.0">
                    <columns>
                        <TableColumn fx:id="columnaMeses" prefWidth="75.0" text="Meses" />
                        <TableColumn fx:id="columnaPagoMensual" prefWidth="75.0" text="Pago" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <TextField fx:id="cantidadTextField" layoutX="34.0" layoutY="237.0">
                    <font>
                        <Font size="22.0" />
                    </font>
                </TextField>
                <Label alignment="CENTER" layoutX="106.0" layoutY="193.0" prefHeight="32.0" prefWidth="129.0" text="Cantidad">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
