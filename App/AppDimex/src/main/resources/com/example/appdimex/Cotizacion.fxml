<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER"
      spacing="14.0"
      prefHeight="650.0"
      prefWidth="340.0"
      fillWidth="true"
      styleClass="ventana-principal"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.appdimex.Controllers.CotizacionController">

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="8.0">

        <ImageView fx:id="logoImageView"
                   fitHeight="45.0"
                   fitWidth="45.0"
                   preserveRatio="true"/>

        <Label text="Cotización Express"
               styleClass="titulo-secundario"
               maxWidth="Infinity"
               HBox.hgrow="ALWAYS"
               alignment="CENTER"/>

        <Button text="Inicio"
                onAction="#regresarAlMain"
                mnemonicParsing="false"
                prefWidth="75.0"
                minWidth="75.0"
                prefHeight="35.0"
                styleClass="btn-action"/>

    </HBox>

    <!-- OPCIONES DE COTIZACIÓN -->
    <VBox spacing="10.0" fillWidth="true">

        <!-- TIPO DE COBRO -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">

            <Label text="Tipo de cobro:"
                   prefWidth="105.0"
                   minWidth="105.0"/>

            <ChoiceBox fx:id="tipoCobroChoiceBox"
                       prefHeight="36.0"
                       maxWidth="Infinity"
                       HBox.hgrow="ALWAYS"/>

        </HBox>

        <!-- TASA DE INTERÉS -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">

            <Label text="Tasa de interés:"
                   prefWidth="105.0"
                   minWidth="105.0"/>

            <ChoiceBox fx:id="tazaInteresChoiceBox"
                       prefHeight="36.0"
                       maxWidth="Infinity"
                       HBox.hgrow="ALWAYS"/>

        </HBox>

        <!-- FORMA DE PAGO -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">

            <Label text="Forma de pago:"
                   prefWidth="105.0"
                   minWidth="105.0"/>

            <ChoiceBox fx:id="formaPagoChoiceBox"
                       prefHeight="36.0"
                       maxWidth="Infinity"
                       HBox.hgrow="ALWAYS"/>

        </HBox>

    </VBox>

    <!-- CANTIDAD -->
    <VBox alignment="CENTER" spacing="8.0">

        <Label text="Cantidad"
               styleClass="titulo-secundario"
               style="-fx-font-size: 20px;"/>

        <TextField fx:id="cantidadTextField"
                   alignment="CENTER"
                   prefWidth="220.0"
                   maxWidth="220.0"
                   prefHeight="45.0">

            <font>
                <Font size="20.0"/>
            </font>

        </TextField>

    </VBox>

    <!-- TABLA DE RESULTADOS -->
    <VBox spacing="7.0" fillWidth="true" VBox.vgrow="ALWAYS">

        <Label text="Resultados de la cotización"
               styleClass="titulo-secundario"
               style="-fx-font-size: 16px;"/>

        <TableView fx:id="cotizacionTableView"
                   prefHeight="200.0"
                   minHeight="150.0"
                   maxHeight="Infinity"
                   maxWidth="Infinity"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="columnaMeses"
                             text="Meses"
                             minWidth="70.0"
                             prefWidth="100.0"/>

                <TableColumn fx:id="columnaPagoMensual"
                             text="Pago mensual"
                             minWidth="100.0"
                             prefWidth="180.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </VBox>

    <!-- BOTONES INFERIORES -->
    <HBox alignment="CENTER"
          spacing="15.0"
          fillHeight="true">

        <Button fx:id="cotizarButton"
                text="Cotizar"
                mnemonicParsing="false"
                prefWidth="130.0"
                minWidth="110.0"
                prefHeight="42.0"
                HBox.hgrow="ALWAYS"
                styleClass="button-exito"/>

        <Button fx:id="borrarButton"
                text="Nueva Cotización"
                mnemonicParsing="false"
                prefWidth="145.0"
                minWidth="130.0"
                prefHeight="42.0"
                HBox.hgrow="ALWAYS"
                styleClass="button-secundario"/>

    </HBox>

</VBox>
